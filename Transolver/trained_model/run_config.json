{
  "epochs": 60,
  "learning_rate": 0.0002,
  "weight_decay": 1e-06,
  "warmup_epochs": 5,
  "lr_floor": 1e-06,
  "grad_clip": 1.0,
  "n_layers": 3,
  "n_hidden": 128,
  "n_head": 4,
  "mlp_ratio": 1,
  "dropout_rate": 0.0,
  "slice_num": 32,
  "ref": 8,
  "time_input": false,
  "unified_pos": false,
  "geometry": "irregular",
  "seed": 42,
  "test_frac": 0.15,
  "train_points": 10000,
  "val_points": 10000,
  "tf_decay_epochs": 30,
  "tf_schedule": "linear",
  "hard_noslip": true,
  "exclude_airfoil_from_loss": false,
  "full_eval_every": 5,
  "deterministic_val_subsets": true,
  "tiny_subset": false,
  "max_train_files": 256,
  "max_test_files": 32,
  "preprocess_in_memory": true,
  "preprocess_cache_to_disk": false,
  "crop_enabled": true,
  "crop_max_dist": 0.4,
  "crop_dist_feature_index": 15,
  "recompute_distance_if_missing": true,
  "subsample_mode": "uniform",
  "keep_all_airfoil": true,
  "biased_sampling_near_wall_power": 1.5,
  "biased_sampling_variance_power": 1.0,
  "biased_sampling_mix_near_wall": 0.5,
  "recon_check_enabled": false,
  "recon_k": 4,
  "recon_rel_threshold": 0.11,
  "recon_check_frames_mode": "subset",
  "recon_cache_memory": true,
  "recon_cache_disk": false,
  "recon_max_attempts": 12,
  "aug_y_flip": true,
  "aug_noise_std_vel": 0.0,
  "aug_noise_std_pos": 0.0,
  "aug_noise_skip_airfoil": true,
  "save_val_per_sample_every": 5,
  "log_crop_stats": true,
  "log_noslip_error": true,
  "log_subsample_stats": true
}